# Telegram BotFather token; set the real value only in the hosting provider's secret settings
TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here
EXCHANGE_ID=binance
DEFAULT_TIMEFRAME=15m
SCAN_SECONDS=60
WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,LINK/USDT,SHIB/USDT,PEPE/USDT,BONK/USDT,WIF/USDT,FLOKI/USDT
DB_PATH=/var/data/smc_bot.db
